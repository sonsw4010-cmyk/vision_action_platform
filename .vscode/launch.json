{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: Runserver (8000)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": [
        "runserver",
        "0.0.0.0:8000"
      ],
      "django": true,
      "cwd": "${workspaceFolder}/backend",
      "python": "/home/user1/ai_vision/subject10_pose_action/.venv/bin/python"
    },
    {
      "name": "FastAPI: AI Service (8001)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8001",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/ai_service",
      "python": "/home/user1/ai_vision/subject10_pose_action/.venv/bin/python"
    }
  ]
}